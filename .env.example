# Alamat backend NestJS. Dipakai server Next meneruskan /api/* dan /uploads/*
# ke backend, jadi dari sisi browser semuanya tetap satu domain dan cookie
# login bekerja seperti biasa.
#
# Dibaca saat SERVER JALAN, jadi isi ini di bagian Environment (bukan Build
# Arguments) di Dokploy. Di jaringan Docker, pakai nama service backendnya,
# misal http://ycs-voting-api:4000
API_PROXY_URL=http://localhost:4000

# Port yang didengarkan server Next di dalam container.
PORT=3000

# WAJIB SAMA PERSIS dengan JWT_SECRET di backend.
#
# Middleware Next memverifikasi cookie login sebelum halaman admin dibuka.
# Kalau nilainya berbeda, tanda tangan cookie dari backend dianggap tidak
# sah dan setiap login admin langsung ditendang ke halaman login, padahal
# kata sandinya benar.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Variabel di bawah ini ikut ter-bundle ke JavaScript yang dikirim ke browser,
# jadi Next membacanya saat BUILD, bukan saat container jalan.
#
# Di Dokploy isi lewat Build Arguments. Kalau ditaruh di Environment saja,
# nilainya tidak akan terpakai dan build memakai nilai bawaan di kode.
# ---------------------------------------------------------------------------

# Domain publik, dipakai metadata SEO dan tautan berbagi.
NEXT_PUBLIC_SITE_URL=https://idola.stekom.ac.id

# Google Analytics. Kosongkan kalau tidak dipakai.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity. Kosongkan kalau tidak dipakai.
NEXT_PUBLIC_CLARITY_ID=

# Token verifikasi Google Search Console. Kosongkan kalau sudah terverifikasi
# lewat cara lain.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
