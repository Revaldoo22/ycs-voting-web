# Nilai untuk build produksi (`next build`). File ini AMAN di-commit:
# hanya berisi nilai publik, tanpa secret.
#
# Catatan: .env.local menimpa file ini kalau ikut ter-deploy ke server.
# Pastikan .env.local TIDAK diunggah ke produksi (isinya nilai dev + JWT_SECRET).

# Dipakai untuk canonical URL, Open Graph, sitemap.xml, dan robots.txt.
NEXT_PUBLIC_SITE_URL=https://idola.stekom.ac.id

# Token verifikasi Google Search Console (metode "HTML tag").
# Ambil dari GSC > Settings > Ownership verification > HTML tag, lalu salin
# HANYA nilai content="..."-nya ke bawah ini. Biarkan kosong kalau verifikasi
# memakai metode DNS atau file HTML.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
